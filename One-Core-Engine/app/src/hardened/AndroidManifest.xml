<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hardened distribution does not install packages, copy external app data,
         or draw overlays. Remove those permissions from the merged manifest. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />

    <application>
        <!-- Remove the feature-rich activity from this variant and keep its
             component name as an alias so existing login/splash navigation still
             lands on the hardened launcher without changing shared source. -->
        <activity
            android:name=".activity.MainActivity"
            tools:node="remove" />

        <activity
            android:name=".activity.HardenedMainActivity"
            android:exported="false" />

        <activity-alias
            android:name=".activity.MainActivity"
            android:enabled="true"
            android:exported="false"
            android:targetActivity=".activity.HardenedMainActivity" />

        <service
            android:name=".floating.Overlay"
            tools:node="remove" />
    </application>
</manifest>
