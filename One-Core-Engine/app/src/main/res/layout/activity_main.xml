<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="PARALLAX CONTROL"
                    android:textColor="@color/premium_gold"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Command Center"
                    android:textColor="@color/white"
                    android:textSize="26sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/ios_icon_bg"
                android:contentDescription="Application settings"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/parallax_labs_brand" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/licenseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/premium_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/premium_stroke_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/ios_icon_bg"
                        android:contentDescription="Parallax Labs"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/parallax_labs_brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/PremiumFileManager"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Protected session"
                            android:textColor="@color/white"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/license_status_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Live encrypted access is active."
                            android:textColor="@color/premium_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/license_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/premium_badge_bg"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="ACTIVE"
                        android:textColor="@color/premium_success"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="License expiry"
                        android:src="@drawable/ic_license_timer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="VALID UNTIL"
                        android:textColor="@color/premium_text_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/license_expiry_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="Checking secure license..."
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/license_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="13dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/license_progress_track" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <include layout="@layout/item_countdown_day" />

                    <include layout="@layout/item_countdown_hour" />

                    <include layout="@layout/item_countdown_minute" />

                    <include layout="@layout/item_countdown_second" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Runtime profile"
            android:textColor="@color/white"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select a supported application and prepare its private environment."
            android:textColor="@color/premium_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/premium_surface"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/premium_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <RadioGroup
                    android:id="@+id/radio_group_games"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radio_india"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:buttonTint="@color/premium_gold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingStart="4dp"
                        android:text="Battlegrounds India"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/premium_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/ios_icon_bg"
                        android:contentDescription="Selected game icon"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pubg_india" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/IndiaName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Battlegrounds"
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/IndiaVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Version 4.2.0"
                            android:textColor="@color/premium_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/installIndia"
                        android:layout_width="100dp"
                        android:layout_height="44dp"
                        android:background="@drawable/premium_outline_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="INSTALL"
                        android:textColor="@color/premium_gold"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/tv_hide_esp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:buttonTint="@color/premium_success"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="Privacy mode during screen recording"
                    android:textColor="@color/premium_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/premium_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="START SECURE SESSION"
                    android:textColor="@color/premium_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/premium_status_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_announcement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Security status"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_announcement2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="● Signature verified   ● Encrypted vault   ● HTTPS transport"
                android:textColor="@color/premium_success"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Optimized for Android 7–16, ARM32/ARM64, cutouts, tablets, and 16 KB page-size devices."
                android:textColor="@color/premium_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="Checking device compatibility…"
                android:textColor="@color/premium_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
