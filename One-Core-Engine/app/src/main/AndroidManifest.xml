<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Real social/auth providers must be visible to the *final Loader APK* on
      Android 11+. The SDK/AAR manifest also declares these, but keeping them in
      the application manifest makes the requirement explicit and prevents a
      manifest-merger/build-variant from silently removing native SSO discovery.
      These are visibility declarations only; the Loader does not claim provider
      web domains or spoof any provider package/signature.
    -->
    <queries tools:node="merge">
        <!-- Google / Play Games -->
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.play.games" />

        <!-- Facebook / Meta -->
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.wakizashi" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.facebook.orca" />
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider" />

        <!-- Twitter / X. Legacy TwitterKit also checks the beta package. -->
        <package android:name="com.twitter.android" />
        <package android:name="com.twitter.android.beta" />
        <package android:name="com.twitter.android.lite" />
        <package android:name="com.x.android" />

        <!-- Browser/Auth Tab discovery used only when a provider SDK chooses web fallback. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>

        <!-- Explicit auth intent visibility. -->
        <intent>
            <action android:name="com.google.android.gms.auth.GOOGLE_SIGN_IN" />
        </intent>
        <intent>
            <action android:name="com.facebook.platform.PLATFORM_ACTIVITY" />
        </intent>
        <intent>
            <action android:name="com.facebook.platform.PLATFORM_SERVICE" />
        </intent>
    </queries>
    
    <!-- Essential permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Scoped storage compatibility -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Critical Permissions with Justification -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Display notifications as full screen activities on a locked device -->
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    
    <permission 
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    
    <application
        android:name=".BoxApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:icon="@mipmap/ic_onecore_edge"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_onecore_edge_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:ignore="GoogleAppIndexingWarning,HardcodedDebugMode"
        tools:targetApi="r">

        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        
        <activity
            android:name=".activity.MainActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        
        <activity
            android:name=".activity.CrashActivity"
            android:launchMode="singleInstance"
            android:exported="false" />
        
        <service android:name=".floating.Overlay" android:stopWithTask="true" />

    </application>
</manifest>