<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AnyTimeCore.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/premium_gold</item>
        <item name="colorPrimaryDark">@color/premium_background</item>
        <item name="colorAccent">@color/premium_gold</item>
        <item name="android:windowBackground">@color/premium_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/premium_background</item>
        <item name="android:navigationBarColor">@color/premium_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/OneCore.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/OneCore.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/OneCore.MaterialAlertDialog</item>
        <item name="dialogCornerRadius">26dp</item>
    </style>

    <style name="OneCore.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/premium_gold</item>
        <item name="colorSurface">@color/premium_surface_light</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/premium_text_secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/OneCore.DialogShape</item>
    </style>

    <style name="OneCore.DialogShape" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="CustomOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/premium_gold</item>
    </style>

    <style name="AppTheme" parent="AnyTimeCore.AppTheme" />

    <style name="TabLayout.TextStyle" parent="@android:style/TextAppearance.Widget.TabWidget">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="roundedImageViewRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="GroupTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/premium_background</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="PKSwitch" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/premium_gold</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <item name="android:colorForeground">#FFFFFF</item>
    </style>

    <style name="PKSwitch2" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/premium_gold</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <item name="android:colorForeground">#FFFFFF</item>
    </style>

</resources>
