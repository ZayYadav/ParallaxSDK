<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/keshavxowner_splash_background">

    <View
        android:id="@+id/ambientGlow"
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="center"
        android:background="@drawable/keshavxowner_splash_glow"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/particleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="38dp"
        android:paddingEnd="28dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/keshavxowner_status_chip"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="ONECORE  /  EDGE"
            android:textColor="@color/premium_gold"
            android:textSize="10sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/brandCard"
            android:layout_width="248dp"
            android:layout_height="248dp"
            android:background="@drawable/keshavxowner_logo_card"
            android:elevation="18dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/onecore_edge_brand_mark" />
        </FrameLayout>

        <ImageView
            android:id="@+id/logoRing"
            android:layout_width="268dp"
            android:layout_height="268dp"
            android:layout_marginTop="-258dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/keshavxowner_orbit_ring" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="ONECORE EDGE SERVER"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/brandSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:text="Secure edge runtime control center"
            android:textColor="@color/premium_text_secondary"
            android:textSize="12sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/keshavxowner_status_dot" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="STARTING ONECORE EDGE SERVER"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/percentageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0%"
                android:textColor="@color/premium_gold"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="13dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/keshavxowner_progress_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="ARM64  &#8226;  API 24-36  &#8226;  SECURE EDGE RUNTIME"
            android:textColor="@color/premium_text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
