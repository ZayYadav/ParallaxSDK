<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F0C96A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/premium_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DF0C96A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99F0C96A" />
        </shape>
    </item>
</selector>
