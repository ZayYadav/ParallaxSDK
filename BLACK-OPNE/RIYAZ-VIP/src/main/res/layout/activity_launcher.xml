<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/keshavxowner_runtime_background">

    <View
        android:id="@+id/runtime_glow"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/keshavxowner_runtime_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="38dp"
        android:paddingEnd="28dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/keshavxowner_runtime_chip"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="Game Opening..."
            android:textColor="#FFD5A94F"
            android:textSize="10sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/brand_panel"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:background="@drawable/keshavxowner_runtime_card"
            android:elevation="16dp">

            <ImageView
                android:id="@+id/iv_brand"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Game Opening..."
                android:scaleType="centerCrop"
                android:src="@drawable/onecore_edge_brand_mark" />
        </FrameLayout>

        <ImageView
            android:id="@+id/brand_ring"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginTop="-220dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/keshavxowner_runtime_ring" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="Game Opening..."
            android:textColor="#FFFFFFFF"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:text="Preparing an isolated app workspace"
            android:textColor="#FFAEB7C7"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/app_identity_card"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/keshavxowner_runtime_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_glow"
                android:contentDescription="Target application"
                android:padding="5dp"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Verified secure profile"
                    android:textColor="#FF5DE2B1"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/runtime_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/keshavxowner_runtime_status_dot" />

            <TextView
                android:id="@+id/launch_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.07"
                android:text="Game Opening..."
                android:textColor="#FFE5E8EE"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/launch_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFD5A94F"
            android:progressBackgroundTint="#24FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="NATIVE  &#8226;  ENCRYPTED  &#8226;  READY"
            android:textColor="#FF717C8F"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
