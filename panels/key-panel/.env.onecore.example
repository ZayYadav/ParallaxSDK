# Add these values to the existing private .env file. Do not upload this
# example with real credentials and never commit the completed .env.

# Existing panel database (keep your current working values)
database.default.hostname = localhost
database.default.database = CHANGE_ME
database.default.username = CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi

# OneCore Integrity database used by the current Android APK
database.integrity.hostname = localhost
database.integrity.database = CHANGE_ME
database.integrity.username = CHANGE_ME
database.integrity.password = CHANGE_ME
database.integrity.DBDriver = MySQLi
database.integrity.port = 3306

# Preserve compatibility with the legacy /connect client. Generate a private
# value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ONECORE_LEGACY_TOKEN_SECRET = CHANGE_TO_A_RANDOM_64_HEX_VALUE
