APP_ENV=production
APP_URL=https://example.com
APP_BASE_PATH=
APP_TIMEZONE=UTC
SESSION_NAME=keshavxowner_panel
SETUP_TOKEN=CHANGE_TO_A_RANDOM_64_HEX_VALUE
# Leave empty on normal hosting. Add only trusted reverse-proxy IPs, separated
# by commas, when TLS terminates at a proxy you control.
TRUSTED_PROXY_IPS=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Telegram control bot. Allowed IDs are also required to be linked to an
# active panel user. Separate multiple IDs with commas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=CHANGE_TO_RANDOM_LETTERS_NUMBERS_UNDERSCORES_HYPHENS
TELEGRAM_ALLOWED_USER_IDS=

# Filled after /setup generates the API key pair. Copy the public value shown
# in Settings to the GitHub repository variable KESHAVXOWNER_API_PUBLIC_KEY_B64.
API_PRIVATE_KEY_PATH=runtime/api-private.pem
API_PUBLIC_KEY_PATH=runtime/api-public.b64

# Server-side binding for encrypted loader requests. Obtain the 64-hex signing
# certificate from the loader-signing-certificate Actions artifact. Separate
# planned certificate-rotation digests with commas.
EXPECTED_ANDROID_PACKAGE=com.onecore.loader
EXPECTED_ANDROID_CERT_SHA256=CHANGE_TO_64_HEX_SIGNING_CERTIFICATE_DIGEST
# Raise this value to reject outdated Loader releases at the encrypted API.
MIN_ANDROID_VERSION_CODE=1
